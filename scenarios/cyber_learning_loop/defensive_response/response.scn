observations:
    "External observations of incoming work and adoption of defensive tools."
    input initial = 1 ratio in [0,] @observation
    input during = 1 ratio in [0,] @observation
    input later = 1 ratio in [0,] @observation
    input change_at = 1 year in [0 years,] @observation
    input duration = 1 year in [0 years,] @observation
    input uptake = 0 fraction in [0, 1] @observation
    adoption = formula(this.uptake) @observation
    pressure = formula(this.initial if t < this.change_at else this.during if t < this.change_at + this.duration else this.later) @observation
        "Total observed incident volume, as a multiple of the reference period."

defenders:
    "The team responding to observed workload."
    input alert_now = 0.05 ratio in [0, 0.2] @attention_today
    input calm_rate = 2 ratio/year in [1 ratio/year, 3 ratio/year] @attention_fades
    input attention_cap = 6 ratio in [2, 20] @saturation
    input hardening_rate = 0 ratio/year in [0 ratio/year, 0.15 ratio/year] @hardening_basis
    input ai_hardening = 0 ratio in [0, 1.5] @hardening_basis
    input close_gain = 2 ratio in [0, 5] @remediation_basis
    attention_target: formula(ratio) = formula(this.alert_now * this.attention_cap * observations.pressure / (observations.pressure + this.attention_cap - 1)) @saturation
        "The attention level sustained by the current volume of observed work."
    alertness: ratio = this.alert_now in [0, 40] scale 1 ratio @attention_balance
        "The current attention index."
    flow alert: SOURCE -> this.alertness @attention_balance
        request = formula(this.calm_rate * this.attention_target)
    flow calm: this.alertness -> SINK @attention_balance
        request = formula(this.alertness * this.calm_rate)
    hardening: formula(ratio) = formula(this.hardening_rate * t + this.ai_hardening * observations.adoption) @hardening_basis
        "The index of lasting defensive improvements."
    closing: formula(ratio) = formula(1 + this.close_gain * observations.adoption) @remediation_basis
        "The pace of discovery and patching relative to the reference period."

defender_attention = formula(defenders.alertness) @attention_balance

record observation: assumption "The caller supplies aggregate incident volume and defensive tooling uptake. A
    volume of one is the reference workload. The two observation boundaries are replay settings."
record attention_today: assumption "The historical model starts the attention index at 0.05. Its units are an
    index, not a share of staff."
record attention_fades: assumption "The historical alertness_fades assumption sets the reference adjustment
    rate to two per year."
record saturation: assumption "The historical attention_cap assumption sets today's workload to today's
    attention and limits the sustained level to six times today's by default."
record attention_balance: identity "The rate drawing attention is the adjustment rate times the sustained
    level. The rate releasing attention is the same rate times current attention."
record hardening_basis: assumption "The historical hardening and defender_ai assumptions add a yearly
    improvement and a gain proportional to measured uptake; both gains default to zero."
record remediation_basis: assumption "The historical rediscovery assumption lets discovery and patching rise
    with uptake of defensive tools; the reference pace is one."
