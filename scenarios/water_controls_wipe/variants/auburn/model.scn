variant "Auburn, Washington"
    summary "Water service, stored supplies and restoration work in Auburn, Washington after an observed
        controls outage."
    scope "The people that the water system of Auburn, Washington serves, the hospitals that it supplies and
        the businesses that need public water there."

auburn: Utility
    "City of Auburn, Washington. Its ID in the federal inventory is WA5303350."
    title "Auburn"
    buys = <>
    sells = <>
    name = "Auburn"
    demand = 11.1622 Mgal/day @auburn_demand
    nameplate = 12055 gallons_per_minute @auburn_nameplate
    storage = 15.86 Mgal @auburn_storage
    bought = 0 megagallons_per_year @auburn_bought
    sold = 0.709704 Mgal/day @auburn_sold
    va_rate = 2571690.02 USD2025/h @auburn_va_rate
    pump_disabled = 0.7 @depth
    manual_share = 0.8 @manual
    activation_delay = 1 h @manual
    controls_load = 400 work_h @work
    field_load = 80 work_h @work

auburn_homes: Households
    "The people that Auburn serves."
    title "Auburn: homes"
    utility = auburn
    population = 107655 people @auburn_homes_population

auburn_hospitals: Hospitals
    "The hospital that Auburn supplies: Multicare Auburn Medical Center."
    title "Auburn: hospitals"
    utility = auburn
    name = "Auburn"
    facilities = 1 facilities @auburn_hospitals_facilities

notes:
    limitations:
        standby-supply: "Auburn can call on Tacoma through two interties and on emergency interties with seven systems, and its plan counts the Tacoma interties in its supply. The model gives it no water from outside the place during the event, so its interruption can be longer here than in fact." @auburn_bought
    verification:
        research: "variants/auburn/evidence/research.md"

record auburn_demand: assumption "The highest day of the present system is 12.43 Mgal/day on July 29, 2020,
    with an average day of 6.32 Mgal/day (ratio 1.96677). Less the Algona sale at that ratio (0.360847 x
    1.96677 = 0.709704) it is 11.7203, and 11.7203 / 1.05 = 11.1622."
    assumption A-SC43-PEAK-DAY
    claims:
        E-SC43-AUBURN-AUBURN-PEAK-DAY
        E-SC43-AUBURN-AUBURN-SALES

record auburn_nameplate: source "The City's own wells (Wells 1, 2, 4, 5, 5A and 6, 7,955 gpm) and springs
    (Coal Creek 3,500 gpm, West Hill 600 gpm) give 12,055 gpm in the plan's supply analysis, which is 17.3592
    Mgal/day. The 3,555 gpm of the Tacoma interties is left out because it is water bought from another
    system; the system has no central treatment plant."
    claims:
        E-SC43-AUBURN-AUBURN-SOURCE-CAPACITY
            datum: own_source_capacity

record auburn_storage: source "The plan's 2024 storage analysis gives a maximum storage capacity of 15.86 MG
    for the eight reservoirs. The model's usable share of 0.8878 comes from the same table, so the model's
    usable storage is the plan's 14.08 MG."
    claims:
        E-SC43-AUBURN-AUBURN-STORAGE
            datum: maximum_storage_capacity

record auburn_bought: assumption "The City has bought no water from Tacoma since 2016, and Table 2-7 shows no
    purchase from 2017 to 2022, so it buys nothing on a normal day."
    assumption A-SC43-PEAK-DAY
    claims:
        E-SC43-AUBURN-AUBURN-PURCHASES
            datum: purchases_after_2016

record auburn_sold: assumption "Algona, the only regular wholesale customer, used 132.07 MG in 2020, or
    0.360847 Mgal/day over 366 days. At the 2020 peak ratio of 1.96677 this is 0.709704 Mgal/day. Lake
    Meridian Water District buys only on an interruptible basis and bought nothing from 2017 to 2022."
    assumption A-SC43-PEAK-DAY
    claims:
        E-SC43-AUBURN-AUBURN-SALES
        E-SC43-AUBURN-AUBURN-PEAK-DAY

record auburn_homes_population: assumption "SDWIS federal data list 107,655 people served by Auburn
    (WA5303350), the system's own report through its state."
    assumption A-SC43-REACH
    claims:
        E-SC43-SDWIS-WA5303350
            datum: population_served

record auburn_va_rate: assumption "107,655 people served times the 2024 GDP per resident of its county (King
    County, Washington (53033): 477,154,354 thousand dollars and 2,340,211 people: 203,893.73 dollars a
    resident) times the price factor 1.026324, over 8,760 h: 2,571,690.02 USD2025/h."
    assumption A-SC43-ECONOMY
    claims:
        E-SC43-SDWIS-WA5303350
        E-SC43-SDWIS-COUNTIES
        E-SC43-BEA-GDP-53033
        E-SC43-BEA-POP-53033
        E-SC43-GDP-DEFLATOR

record auburn_hospitals_facilities: assumption "The CMS hospital list gives 1 hospital of the counted types
    whose geocoded address lies in the EPA service area of Auburn."
    assumption A-SC43-HOSPITAL-JOIN
    claims:
        E-SC43-HOSPITALS-AUBURN
            datum: hospitals_supplied
