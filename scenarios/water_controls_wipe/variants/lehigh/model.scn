# Water systems' controls wiped through a shared remote-support platform: Lehigh County and Erie, Pennsylvania
variant "Lehigh County and Erie, Pennsylvania"
    summary "An AI agent wipes the controls of the water systems of Lehigh County and Erie, Pennsylvania at
        once, through the remote-support platform of the OT integrator that they share: Lehigh County
        Authority and Erie Water Works."
    scope "The people that the water systems of Lehigh County and Erie, Pennsylvania serve, the hospitals that
        those systems supply and the businesses that need public water there."

lehigh_county_authority: Utility
    "Lehigh County Authority (LCA WaterWorks) - Allentown Division. Its ID in the federal inventory is
        PA3390024."
    title "Lehigh County Authority"
    let buys = []
    let sells = []
    name = "Lehigh County Authority"
    demand = 19.8115 Mgal/day  @lehigh_county_authority_demand
    nameplate = 39 Mgal/day  @lehigh_county_authority_nameplate
    storage = 50 Mgal  @lehigh_county_authority_storage
    sold = 10.0688 Mgal/day  @lehigh_county_authority_sold
    va_rate = 1137758.5 USD2025/h  @lehigh_county_authority_va_rate

erie_water: Utility
    "Erie Water Works (Erie City Water Authority). Its ID in the federal inventory is PA6250028."
    title "Erie Water Works"
    let buys = []
    let sells = []
    name = "Erie Water Works"
    demand = 37.42 Mgal/day  @erie_water_demand
    nameplate = 77 Mgal/day  @erie_water_nameplate
    storage = 77 Mgal  @erie_water_storage
    sold = 1.809 Mgal/day  @erie_water_sold
    va_rate = 1446296.29 USD2025/h  @erie_water_va_rate

lehigh_county_authority_homes: Households
    "The people that Lehigh County Authority serves."
    title "Lehigh County Authority: homes"
    let utility = lehigh_county_authority
    population = 118000 people  @lehigh_county_authority_homes_population

erie_water_homes: Households
    "The people that Erie Water Works serves."
    title "Erie Water Works: homes"
    let utility = erie_water
    population = 220001 people  @erie_water_homes_population

erie_water_hospitals: Hospitals
    "The 4 hospitals that Erie Water Works supplies: Saint Vincent Hospital; Erie VA Medical Center; UPMC
        Hamot; LECOM Medical Center and Behavioral Health Pav."
    title "Erie Water Works: hospitals"
    let utility = erie_water
    name = "Erie Water Works"
    facilities = 4 facilities  @erie_water_hospitals_facilities

notes:
    limitations:
        bulk-users: "The Allentown system sells water to four bulk users whose volumes no source gives. The
            model keeps their water in LCA's own use, which LCA serves before its sales. So LCA's own
            customers can get less of the water that is left here than in
            fact."  @lehigh_county_authority_sold
        elevated-tanks: "The 50 Mgal of LCA's storage leaves out its four elevated tanks, whose volume no
            source gives. So LCA's stored water can run out sooner here than in
            fact."  @lehigh_county_authority_storage
    verification:
        research: "variants/lehigh/evidence/research.md"

record lehigh_county_authority_demand: assumption A-SC43-PEAK-DAY "The highest day on record in LCA's
    2016-2025 table is 30.8709 Mgal/day (2022), 1.3718 times the 2022 average of 22.5044. Less the 2022 sale
    to LCA's Suburban Division at the same ratio (7.34 x 1.3718 = 10.0688) and divided by 1.05: (30.8709 -
    10.0688) / 1.05 = 19.8115 Mgal/day."
    claims:
        E-SC43-LEHIGH-LCA-PEAK
        E-SC43-LEHIGH-LCA-SALES-2022

record lehigh_county_authority_nameplate: source "The City's permits allow 39 Mgal/day of drinking water from
    the Allentown plant, of which at most 30 Mgal/day passes through filtration (creek and river water); the
    two springs, about half of the supply, need only disinfection. One plant site: the Water Filtration Plant
    with the spring supply."
    claims:
        E-SC43-LEHIGH-LCA-CAPACITY
            datum: permitted_discharge

record lehigh_county_authority_storage: source "Three finished-water reservoirs (30, 10 and 10 Mgal) with a
    combined capacity of 50 Mgal, reported by the City in its 2024 concession report and by LCA; the four
    elevated tanks are not counted."
    claims:
        E-SC43-LEHIGH-LCA-STORAGE
            datum: finished_storage
        E-SC43-LEHIGH-LCA-RESERVOIRS
            datum: finished_storage

record lehigh_county_authority_sold: assumption A-SC43-PEAK-DAY "LCA's Suburban Division bought 7.34 Mgal/day
    from Allentown in 2022, the year of the record day; at the peak ratio 1.3718: 7.34 x 1.3718 = 10.0688
    Mgal/day. The sale continues (6.89 in 2024, 6.46 in 2025). The volumes sold to the four township bulk
    users are not reported, so this is a floor."
    claims:
        E-SC43-LEHIGH-LCA-SALES-2022
        E-SC43-LEHIGH-LCA-PEAK
        E-SC43-LEHIGH-LCA-SALES
        E-SC43-LEHIGH-LCA-BULK

record lehigh_county_authority_homes_population: assumption A-SC43-REACH "SDWIS federal data list 118,000
    people served by Lehigh County Authority (PA3390024), the system's own report through its state."
    claims:
        E-SC43-SDWIS-PA3390024
            datum: population_served

record lehigh_county_authority_va_rate: assumption A-SC43-ECONOMY "118,000 people served times the 2024 GDP
    per resident of its county (Lehigh County, Pennsylvania (42077): 31,738,508 thousand dollars and 385,655
    people: 82,297.67 dollars a resident) times the price factor 1.026324, over 8,760 h: 1,137,758.50
    USD2025/h."
    claims:
        E-SC43-SDWIS-PA3390024
        E-SC43-SDWIS-COUNTIES
        E-SC43-BEA-GDP-42077
        E-SC43-BEA-POP-42077
        E-SC43-GDP-DEFLATOR

record erie_water_demand: assumption A-SC43-PEAK-DAY "Maximum day 41.1 Mgal/day from ten years of history
    (average 23.9, ratio 1.7197). Less the bulk sales to Summit and Fairview township authorities, 1.052
    Mgal/day billed (fiscal 2020 projection) at the same ratio (1.8090), divided by 1.05: (41.1 - 1.8090) /
    1.05 = 37.4200 Mgal/day."
    claims:
        E-SC43-LEHIGH-ERIE-DEMAND
        E-SC43-LEHIGH-ERIE-BULK
        E-SC43-LEHIGH-ERIE-AVERAGE-2019

record erie_water_nameplate: source "Maximum treatment capacities of the two Lake Erie plants in the 2017
    master plan: Richard S. Wasielewski WTP 45.0 Mgal/day (membranes, at 14 degrees C) and Chestnut Street WTP
    32.0 Mgal/day (conventional; used at peaks and during maintenance). Both were in service in 2025."
    claims:
        E-SC43-LEHIGH-ERIE-CAPACITY
            datum: total_capacity
        E-SC43-LEHIGH-ERIE-RATINGS
        E-SC43-LEHIGH-ERIE-PLANTS-2025

record erie_water_storage: source "Nearly 77 Mgal of stored water: about 14 Mgal in 13 steel tanks and 63 Mgal
    in six ground reservoirs (Q3 2023 newsletter); 71.25 Mgal before the Millcreek tanks were added (2017)."
    claims:
        E-SC43-LEHIGH-ERIE-STORAGE
            datum: finished_storage
        E-SC43-LEHIGH-ERIE-RATINGS

record erie_water_sold: assumption A-SC43-PEAK-DAY "Bulk sales to the Summit Township and Fairview Township
    water authorities: 513,293 CCF billed in the fiscal 2020 projection = 1.052 Mgal/day; at the peak ratio
    1.7197: 1.8090 Mgal/day."
    claims:
        E-SC43-LEHIGH-ERIE-BULK
        E-SC43-LEHIGH-ERIE-DEMAND
        E-SC43-LEHIGH-ERIE-BUYERS

record erie_water_homes_population: assumption A-SC43-REACH "SDWIS federal data list 220,001 people served by
    Erie Water Works (PA6250028), the system's own report through its state."
    claims:
        E-SC43-SDWIS-PA6250028
            datum: population_served

record erie_water_va_rate: assumption A-SC43-ECONOMY "220,001 people served times the 2024 GDP per resident of
    its county (Erie County, Pennsylvania (42049): 15,023,861 thousand dollars and 267,750 people: 56,111.53
    dollars a resident) times the price factor 1.026324, over 8,760 h: 1,446,296.29 USD2025/h."
    claims:
        E-SC43-SDWIS-PA6250028
        E-SC43-SDWIS-COUNTIES
        E-SC43-BEA-GDP-42049
        E-SC43-BEA-POP-42049
        E-SC43-GDP-DEFLATOR

record erie_water_hospitals_facilities: assumption A-SC43-HOSPITAL-JOIN "The CMS hospital list gives 4
    hospitals of the counted types whose geocoded address lies in the EPA service area of Erie Water Works."
    claims:
        E-SC43-HOSPITALS-ERIE-WATER
            datum: hospitals_supplied
