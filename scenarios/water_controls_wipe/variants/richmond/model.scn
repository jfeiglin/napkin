# Water systems' controls wiped through a shared remote-support platform: Richmond, Virginia
variant "Richmond, Virginia"
    summary "An AI agent wipes the controls of the water system of Richmond, Virginia through the
        remote-support platform of the OT integrator that it uses."
    scope "The people that the water system of Richmond, Virginia serves, the hospitals that it supplies and
        the businesses that need public water there."

richmond: Utility
    "City of Richmond, Virginia, Department of Public Utilities (water). Its ID in the federal inventory is
        VA4760100."
    title "Richmond"
    let buys = []
    let sells = []
    name = "Richmond"
    demand = 52.1656 Mgal/day  @richmond_demand
    nameplate = 132 Mgal/day  @richmond_nameplate
    storage = 69 Mgal  @richmond_storage
    sold = 41.2262 Mgal/day  @richmond_sold
    va_rate = 4112990.15 USD2025/h  @richmond_va_rate

richmond_homes: Households
    "The people that Richmond serves."
    title "Richmond: homes"
    let utility = richmond
    population = 233655 people  @richmond_homes_population

richmond_hospitals: Hospitals
    "The 3 hospitals that Richmond supplies: Bon Secours Richmond Community Hospital; Cjw Medical Center;
        Medical College of Virginia Hospitals."
    title "Richmond: hospitals"
    let utility = richmond
    name = "Richmond"
    facilities = 3 facilities  @richmond_hospitals_facilities

notes:
    limitations:
        byrd-park: "In 2025 one basin of the Byrd Park Reservoir, the main reservoir, was out of service,
            which halved that reservoir. The model keeps the 69 Mgal of storage, so the stored water lasts
            longer here than in fact while the basin is out of service."  @richmond_storage
        hospital-floor: "The Census geocoder does not match the CMS address of the Richmond VA Medical Center,
            so the model leaves it out. So the hospital hours short of water are lower here than in
            fact."  @richmond_hospitals_facilities
    verification:
        research: "variants/richmond/evidence/research.md"

record richmond_demand: assumption A-SC43-PEAK-DAY "Peak day 96 Mgal/day (DPU; Henrico calls it the historical
    summer peak) is 1.4953 times the 2025 average of 64.2. Less the wholesale sales to Henrico, Chesterfield
    and Hanover (12.43 + 9.14 + 6.0 = 27.57) at the same ratio (41.2262) and divided by 1.05: (96 - 41.2262) /
    1.05 = 52.1656 Mgal/day."
    claims:
        E-SC43-RICHMOND-DPU-STORAGE
        E-SC43-RICHMOND-DPU-PEAK
        E-SC43-RICHMOND-DPU-PRODUCTION
        E-SC43-RICHMOND-DPU-WHOLESALE

record richmond_nameplate: source "Permitted capacity of the one James River plant, which runs as two
    independent trains: Plant No. 1 (60 Mgal/day) and Plant No. 2 (72 Mgal/day)."
    claims:
        E-SC43-RICHMOND-DPU-PLANT
            datum: permitted_capacity
        E-SC43-RICHMOND-DPU-PRODUCTION
            datum: plant_capacity

record richmond_storage: source "Finished water storage given by Richmond DPU at the joint meeting of June 30,
    2025: 69 Mgal. VDH counts 11 finished water storage facilities in 9 pressure zones."
    claims:
        E-SC43-RICHMOND-DPU-STORAGE
            datum: finished_storage
        E-SC43-RICHMOND-DPU-PLANT

record richmond_sold: assumption A-SC43-PEAK-DAY "Average wholesale demand of Henrico (12.43), Chesterfield
    (9.14) and Hanover (6.0), 27.57 Mgal/day, none of them in the scenario; at the peak ratio 1.4953: 41.2262
    Mgal/day, within the contract maxima (35, 32 x 1.05 and 20 x 1.05 Mgal/day)."
    claims:
        E-SC43-RICHMOND-DPU-WHOLESALE
        E-SC43-RICHMOND-DPU-PRODUCTION
        E-SC43-RICHMOND-DPU-STORAGE

record richmond_homes_population: assumption A-SC43-REACH "SDWIS federal data list 233,655 people served by
    Richmond (VA4760100), the system's own report through its state."
    claims:
        E-SC43-SDWIS-VA4760100
            datum: population_served

record richmond_va_rate: assumption A-SC43-ECONOMY "233,655 people served times the 2024 GDP per resident of
    its county (Richmond city (independent city), Virginia (51760): 35,105,659 thousand dollars and 233,655
    people: 150,245.70 dollars a resident) times the price factor 1.026324, over 8,760 h: 4,112,990.15
    USD2025/h. County basis: SDWIS lists no county for Richmond, only the city (claim E-SC43-SDWIS-COUNTIES);
    BEA reports the independent city of Richmond as the county equivalent 51760."
    claims:
        E-SC43-SDWIS-VA4760100
        E-SC43-SDWIS-COUNTIES
        E-SC43-BEA-GDP-51760
        E-SC43-BEA-POP-51760
        E-SC43-GDP-DEFLATOR

record richmond_hospitals_facilities: assumption A-SC43-HOSPITAL-JOIN "The CMS hospital list gives 3 hospitals
    of the counted types whose geocoded address lies in the EPA service area of Richmond. The count is a
    floor: the Census geocoder does not match the CMS address of Richmond VA Medical Center, so the join does
    not place it."
    claims:
        E-SC43-HOSPITALS-RICHMOND
            datum: hospitals_supplied
