# Water systems' controls wiped through a shared remote-support platform: Cape May County, New Jersey
variant "Cape May County, New Jersey"
    summary "An AI agent wipes the controls of the water systems of Cape May County, New Jersey at once,
        through the remote-support platform of the OT integrator that they share: Cape May and Woodbine."
    scope "The people that the water systems of Cape May County, New Jersey serve, the hospitals that those
        systems supply and the businesses that need public water there."

cape_may: Utility
    "City of Cape May Water & Sewer Utility. Its ID in the federal inventory is NJ0502001."
    title "Cape May"
    let buys = []
    let sells = []
    name = "Cape May"
    demand = 2.0395 Mgal/day  @cape_may_demand
    nameplate = 2.96 Mgal/day  @cape_may_nameplate
    storage = 1.75 Mgal  @cape_may_storage
    bought = 0 Mgal/yr  @cape_may_bought
    sold = 0.6585 Mgal/day  @cape_may_sold
    va_rate = 340767.79 USD2025/h  @cape_may_va_rate
    pump_disabled = 0.7  @depth
    manual_share = 0.8  @manual
    activation_delay = 1 h  @manual
    controls_load = 400 work_h  @work
    field_load = 80 work_h  @work

woodbine: Utility
    "Borough of Woodbine (Woodbine Water Department, formerly Woodbine MUA). Its ID in the federal inventory
        is NJ0516001."
    title "Woodbine"
    let buys = []
    let sells = []
    name = "Woodbine"
    demand = 0.467914 Mgal/day  @woodbine_demand
    nameplate = 1.08 Mgal/day  @woodbine_nameplate
    storage = 500000 gal  @woodbine_storage
    bought = 0 Mgal/day  @woodbine_bought
    sold = 0 Mgal/day  @woodbine_sold
    va_rate = 25800.99 USD2025/h  @woodbine_va_rate
    pump_disabled = 0.8  @depth
    manual_share = 0.9  @manual
    activation_delay = 1 h  @manual
    operator_duty = 0 work_h/h  @operator_competition
    controls_load = 40 work_h  @work
    field_load = 10 work_h  @work
    replace_load = 20 work_h  @work

cape_may_homes: Households
    "The people that Cape May serves."
    title "Cape May: homes"
    let utility = cape_may
    population = 35000 people  @cape_may_homes_population

woodbine_homes: Households
    "The people that Woodbine serves."
    title "Woodbine: homes"
    let utility = woodbine
    population = 2650 people  @woodbine_homes_population

notes:
    limitations:
        emergency-interconnect: "Cape May has an emergency interconnect with Lower Township MUA, of unknown
            capacity. The model gives the city no water from outside the place during the event, so its
            interruption can be longer here than in fact."  @cape_may_bought
        woodbine-firm-capacity: "Woodbine's plant capacity in the model is its firm capacity, with its largest
            unit out of service. So its production by hand and its refill can be slower here than in
            fact."  @woodbine_nameplate
    verification:
        research: "variants/cape_may/evidence/research.md"

record cape_may_demand: assumption A-SC43-PEAK-DAY "The maximum day demand is approximately 2.80 MGD and the
    annual average 0.95 MGD, a peak ratio of 2.9474. The 2023 sales to West Cape May, Cape May Point and Lower
    Township were 81.547 MGY (0.2234 MGD), 0.6585 MGD at that ratio. (2.80 - 0.6585) / 1.05 = 2.0395. The
    Coast Guard training center is not a separate water system, so its use stays in the demand."
    claims:
        E-SC43-CAPEMAY-CAPE-MAY-DEMAND
        E-SC43-CAPEMAY-CAPE-MAY-BUYERS
        E-SC43-CAPEMAY-CAPE-MAY-STORAGE

record cape_may_nameplate: source "Total capacity of the existing plant: two reverse osmosis trains of 0.98
    MGD and Well 5 at 1.00 MGD. The firm capacity, with the largest unit out of service, is 1.96 MGD (2.000
    MGD for NJDEP)."
    claims:
        E-SC43-CAPEMAY-CAPE-MAY-CAPACITY
            datum: total_plant_capacity
        E-SC43-CAPEMAY-CAPE-MAY-NJDEP

record cape_may_storage: source "The two tanks that the city lists: a 1 MG standpipe at the water plant and a
    0.75 MG elevated tank at Columbia and Madison avenues, 1.75 MG. The same document calls the Madison Avenue
    tank 700,000 gallons, which would give 1.70 MG."
    claims:
        E-SC43-CAPEMAY-CAPE-MAY-STORAGE
            datum: storage_total

record cape_may_bought: source "Cape May produces all its water. NJDEP records a contract limit of 0.000 for
    purchased water; the only link is an emergency interconnect with Lower Township MUA, of unknown capacity."
    claims:
        E-SC43-CAPEMAY-CAPE-MAY-NJDEP
            datum: contract_limit
        E-SC43-CAPEMAY-CAPE-MAY-STORAGE

record cape_may_sold: assumption A-SC43-PEAK-DAY "Sales to the three water systems outside the scenario that
    buy from Cape May (West Cape May, Cape May Point and Lower Township MUA): 81.547 MGY in 2023, 0.2234 MGD,
    times the peak ratio 2.9474 = 0.6585 MGD."
    claims:
        E-SC43-CAPEMAY-CAPE-MAY-DEMAND
        E-SC43-CAPEMAY-CAPE-MAY-BUYERS

record cape_may_homes_population: assumption A-SC43-REACH "SDWIS federal data list 35,000 people served by
    Cape May (NJ0502001), the system's own report through its state."
    claims:
        E-SC43-SDWIS-NJ0502001
            datum: population_served

record cape_may_va_rate: assumption A-SC43-ECONOMY "35,000 people served times the 2024 GDP per resident of
    its county (Cape May County, New Jersey (34009): 7,801,173 thousand dollars and 93,875 people: 83,101.71
    dollars a resident) times the price factor 1.026324, over 8,760 h: 340,767.79 USD2025/h."
    claims:
        E-SC43-SDWIS-NJ0502001
        E-SC43-SDWIS-COUNTIES
        E-SC43-BEA-GDP-34009
        E-SC43-BEA-POP-34009
        E-SC43-GDP-DEFLATOR

record woodbine_demand: assumption A-SC43-PEAK-DAY "No source reports a highest day. The 2020 yearly demand of
    116.475 MGY is 0.3182 MGD; times the family median ratio 1.54385 it gives 0.4913 MGD, above the 0.457 MGD
    mean of the highest month (July 2020), which is a floor for the highest day. Woodbine sells no water, so
    0.4913 / 1.05 = 0.4679."
    claims:
        E-SC43-CAPEMAY-WOODBINE-DEMAND

record woodbine_nameplate: source "NJDEP firm capacity of the two-well system, 1.080 MGD. It is the capacity
    with the largest unit out of service, so the full capacity is larger; no source gives it."
    claims:
        E-SC43-CAPEMAY-WOODBINE-CAPACITY
            datum: firm_capacity

record woodbine_storage: source "The borough's one water tower, 500,000 gallons (2019 master plan). No other
    tank is named."
    claims:
        E-SC43-CAPEMAY-WOODBINE-STORAGE
            datum: water_tower

record woodbine_bought: source "Woodbine takes all its water from its two wells; NJDEP lists no contract
    (purchased) water."
    claims:
        E-SC43-CAPEMAY-WOODBINE-SOURCES
        E-SC43-CAPEMAY-WOODBINE-CAPACITY

record woodbine_sold: source "No source names a buyer of Woodbine water. The NJDEP committed peak of 0.405 MGD
    is for approved projects not yet built."
    claims:
        E-SC43-CAPEMAY-WOODBINE-DEMAND

record woodbine_homes_population: assumption A-SC43-REACH "SDWIS federal data list 2,650 people served by
    Woodbine (NJ0516001), the system's own report through its state."
    claims:
        E-SC43-SDWIS-NJ0516001
            datum: population_served

record woodbine_va_rate: assumption A-SC43-ECONOMY "2,650 people served times the 2024 GDP per resident of its
    county (Cape May County, New Jersey (34009): 7,801,173 thousand dollars and 93,875 people: 83,101.71
    dollars a resident) times the price factor 1.026324, over 8,760 h: 25,800.99 USD2025/h."
    claims:
        E-SC43-SDWIS-NJ0516001
        E-SC43-SDWIS-COUNTIES
        E-SC43-BEA-GDP-34009
        E-SC43-BEA-POP-34009
        E-SC43-GDP-DEFLATOR
