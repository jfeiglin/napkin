scenario "IV-fluid supply and recovery"
    summary "A manufacturer pauses IV-fluid shipments. Hospital reserves, procurement and outside supply cover
        demand while the release team qualifies its systems and reviews lots. The model follows fluid, work,
        patient courses and costs for sixty days."
    horizon 1440 h
    scope "One hypothetical manufacturer and a network of 100 hospitals."
    library "../library"

manufacturer: @a_pilot_assumed_brief
    "The manufacturer supplies most of the network’s IV fluid. It restores service, reviews release records
        and holds lots when product checks find a discrepancy."
    readonly study_length = 1440 h
        "Length of the study period"
        @assumption "The scenario assumes 1440 h. Published incidents show how this works, but only under the
            conditions that they observed. The range of values used to test this input is also an assumption."
            assumption RT-SECTOR-SC10-2026
    input containment_time = 312 h in [0 h, 1200 h] @containment_time
        "Time to contain the initial incident"
    input release_allowed = true
        "Qualified release allowed during recovery"
        @assumption "The scenario sets this to 1, which means that qualified release is allowed during
            recovery. Published incidents show how this works, but only under the conditions that they
            observed. The range of values used to test this input is also an assumption."
            assumption RT-SECTOR-SC10-2026
    input reset_delay = 24 h in [0 h, 336 h] @reset_delay
        "Time after release restarts until records-system remediation is complete"
    input time_to_find = 216 h in [24 h, 720 h] @found_by_product_check
        "Time until altered records are found"
    input value_added_rate = 12500 USD2025/h in [0 USD2025/h, 10000000 USD2025/h]
        "Manufacturer's value added permanently lost per hour out of operation"
        @assumption "Net value added that the manufacturer loses: $12500 an hour, at 2025 prices. Reported
            cyber losses at pharmaceutical companies show how such losses are counted. This local rate is
            chosen for this scenario."
            assumption A-SC10-CONSEQUENCES-2026
    input recovery_cost = 12000000 USD2025 in [0 USD2025, 1000000000 USD2025]
        "Manufacturer's cyber recovery cost"
        @assumption "The scenario assumes cyber recovery costs of twelve million US dollars for the
            manufacturer, at 2025 prices."
            assumption A-SC10-CONSEQUENCES-2026
    # While the release systems are encrypted, the manufacturer cannot release or ship: it is out of
    # operation.
    hours_out: h = 0 scale 1440 h @keeps_count_limited @service_recovery
        "Time the manufacturer is out of operation"
    flow add_hours_out: SOURCE -> this.hours_out
        @keeps_count_limited @service_recovery
        request = formula(1 if release_systems.state == INTERRUPTED else 0)
        capacity = formula(1 if release_systems.state == INTERRUPTED else 0)
    output_loss: formula(USD2025_bn) = formula(this.hours_out * this.value_added_rate) in [0,] @counts_fixed_group
        "Manufacturer's value added permanently lost"
    recovery_loss: formula(USD2025_bn) = formula(this.recovery_cost if this.hours_out > 0 h else 0 USD2025) in [0,] @counts_fixed_group
        "Manufacturer's cyber recovery cost"
    status failed when release_systems.state == INTERRUPTED
        "Output and backlog still disrupted"
    status ok
        "Manufacturer operational"
    stops_shipping = event(): @service_recovery
        "Manufacturer shipments stop and the hospitals begin their procurement clock."
        when t >= 0 h:
            this.stops_shipping.start()
        after 0 h:
            release_systems.state = INTERRUPTED
    containment_complete = event(): @service_recovery
        "Initial containment completes. Qualified shipments can resume once release work and procurement are
            ready."
        when count(this.stops_shipping.occurrences) > 0 and since(this.stops_shipping) >= this.containment_time:
            this.containment_complete.start()
        after 0 h:
            release_systems.containment = COMPLETE
    records_restored = event(): @service_recovery
        "The manufacturer completes its records-service recovery after the release line restarts."
        when count(release_team.restart_release.occurrences) > 0 and since(release_team.restart_release) >= this.reset_delay:
            this.records_restored.start()
        after 0 h:
            release_systems.records_service = COMPLETE
    discrepancy_confirmed = event(): @product_reconciliation
        "The physical product review confirms that released lots should be held. Fluid on hand is set aside."
        when count(records.review_pending.occurrences) > 0 and since(records.review_pending) >= this.time_to_find:
            this.discrepancy_confirmed.start()
        after 0 h:
            records.state = HOLD
            deliveries.state = HELD
            move min(resuscitation_reserve.stock, deliveries.received_each) from resuscitation_reserve.stock to resuscitation_reserve.held
            move min(other_care_reserve.stock, deliveries.received_each) from other_care_reserve.stock to other_care_reserve.held
            move release_team.product_work from release_team.reserve to release_team.to_reconcile
            release_team.state = RECONCILING_AGAINST_PRODUCT
    study_ends = event(): @service_recovery
        "The study ends."
        when t >= this.study_length:
            this.study_ends.start()
        after 0 h:
            release_systems.state = RESTORED
            hospitals.procurement = CLOSED

release_systems: @service_recovery
    state: enum[WORKING, INTERRUPTED, RESTORED] = WORKING
    containment: enum[PENDING, COMPLETE] = PENDING
    records_service: enum[PENDING, COMPLETE] = PENDING
    status failed when this.state == INTERRUPTED
    status ok

records: @service_recovery
    title "Release records"
    input initial_review: enum[ROUTINE, ADDITIONAL] = ROUTINE
        "Qualification review for the first procurement order"
    input released_lot: enum[CLEAR, NEEDS_CHECK] = CLEAR
        "Condition of the lot when the manufacturer releases it"
    readonly sample_delay = 0.25 h @product_reconciliation
        "Time from lot release to the start of the product check"
    state: enum[ROUTINE, REVIEW, RECONCILED, PENDING_CHECK, HOLD] = ROUTINE
    status failed when this.state == HOLD
    status degraded when this.state == REVIEW or this.state == PENDING_CHECK
    status ok
    review_pending = event(): @product_reconciliation
        "The independent product check begins for the released lot."
        after 0 h

hospitals: @a_pilot_assumed_brief
    "The 100 hospitals that use the manufacturer's IV fluid. They start emergency procurement after the
        manufacturer stops shipping. Outside supply and transfers can then rescue some of the most
        fluid-dependent patients."
    input days_on_hand: days = 15 days in [3 days, 30 days]
        "Days of fluid stock on hand"
        @assumption "Hospitals typically held 15 to 22 days of IV fluid before the 2024 shortage. The scenario
            uses the low end for each of its two reserves: fluid kept for resuscitation and fluid for other
            essential care."
            assumption RT-SECTOR-SC10-2026
        @source_transfer "Hospitals typically held 15 to 22 days of IV fluid before the 2024 shortage; the
            default takes the lower end and the range reaches the 3-day minimum observed."
            claims:
                E-PREMIER24-BUFFER
                E-ASHP24-INVENTORY
                E-GORGENS26-STOCK
    input start_delay = 72 h in [0.5 h, 240 h] @start_delay @a_pilot_assumed_brief
        "Time until hospitals start emergency procurement"
    input rescue_capacity = 10 people/day in [0 people/day, 300 people/day] @rescue_capacity
        "Most fluid-dependent patients rescued each day"
    input procedure_volume = 2 L/people in [0.1 L/people, 20 L/people]
        "Fluid needed for each postponed procedure"
        @assumption "The scenario assumes 2 L of fluid for each postponed procedure in other essential care.
            These patients form their own separate group."
            assumption A-SC10-CONSEQUENCES-2026
    input procedure_value = 100 USD2025/person in [0 USD2025/person, 100000 USD2025/person]
        "Value added permanently lost per postponed procedure"
        @assumption "The scenario assumes that the hospital permanently loses $100 of net value added for each
            postponed procedure, at 2025 prices. Procedures that hospitals make up later add zero permanent
            loss."
            assumption A-SC10-CONSEQUENCES-2026
    procurement: enum[NORMAL, EMERGENCY, CLOSED] = NORMAL
        "Emergency procurement"
    status inactive when this.procurement == NORMAL
        "Emergency procurement not started"
    status ok
        "Emergency procurement started"
    emergency_procurement = event():
        "Hospitals start emergency procurement: they assess stock, protect resuscitation courses and arrange
            outside supply and transfers for the most fluid-dependent patients."
        @assumption "The scenario assumes that the hospitals learn of the stop in shipping when the
            manufacturer tells them, or when it does not fill their orders. The time until they start
            emergency procurement counts from the stop, so it includes the time to learn of it."
            assumption A-SC10-pilot
            claims:
                SC10-SUPPLY-CONSERVATION
        @source_transfer "Sources show that hospitals assess stock, set priorities and save fluid. The
            scenario assumes the time until hospitals start."
            claims:
                SC10-SUPPLY-CONSERVATION
                E-ASHP24-INVENTORY
                E-GORGENS26-TRIAGE
        @assumption "Sources show that hospitals in fluid shortages assess stock, set priorities and save
            fluid."
            assumption A-SC10-pilot
            claims:
                SC10-SUPPLY-CONSERVATION
        when this.procurement == NORMAL and count(manufacturer.stops_shipping.occurrences) > 0 and since(manufacturer.stops_shipping) >= this.start_delay:
            this.emergency_procurement.start()
        after 0 h:
            this.procurement = EMERGENCY
            if records.initial_review == ADDITIONAL and release_team.records_work > 0 work_h:
                records.state = REVIEW
                move release_team.records_work from release_team.reserve to release_team.to_reconcile

release_team:
    "The manufacturer's release team. It restores the systems, requalifies release and reconciles the records,
        one task at a time and at one pace. It does the ordinary work first, then any reconciliation."
    @qualification_work @service_recovery
    input ordinary_work = 504 work_h in [24 work_h, 1000 work_h]
        "Ordinary qualification and release work"
        @assumption "The scenario assumes 504 work-hours. Published incidents show how this works, but only
            under the conditions that they observed. The range of values used to test this input is also an
            assumption."
            assumption RT-SECTOR-SC10-2026
    input pace = 1 work_h/h in [0.25 work_h/h, 8 work_h/h] @pace
        "Pace of the manufacturer's release work"
    input records_work = 0 work_h in [0 work_h, 240 work_h] @records_work
        "Work-hours to reconcile altered records"
        @assumption "The manufacturer re-verifies its release and shipment records after they are altered: a
            week of work at the standard pace."
            assumption RT-SC10-INTEGRITY-REVERIFY
    input product_work = 336 work_h in [0 work_h, 720 work_h] @product_reconciliation
        "Work-hours to reconcile the records against the product"
        @assumption "Reconciliation work against the product, in work hours at the standard pace."
    state: enum[QUALIFYING, RECONCILING, READY, RELEASED, RECONCILING_AGAINST_PRODUCT] = QUALIFYING
        "Release work"
    ordinary_left: work_h = this.ordinary_work + (0 work_h if records.initial_review == ADDITIONAL else this.records_work) in [0,] scale 1000 work_h @qualification_work
    reserve: work_h = (this.records_work if records.initial_review == ADDITIONAL else 0 work_h) + (this.product_work if records.initial_review == ADDITIONAL or records.released_lot == NEEDS_CHECK else 0 work_h) in [0,] scale 1000 work_h @balances_stocks_work
    to_reconcile: work_h = 0 in [0,] scale 1000 work_h @balances_stocks_work
    work_done: work_h = 0 scale 1000 work_h @balances_stocks_work
    status ok when this.state == READY or this.state == RELEASED
        "All qualification and reconciliation work complete"
    status degraded
        "One team does ordinary work first, then reconciliation"
    flow qualify: this.ordinary_left -> this.work_done @balances_stocks_work
        "The team does the ordinary qualification and release work."
        request = formula(this.pace if this.state == QUALIFYING else 0)
        capacity = formula(this.pace if this.state == QUALIFYING else 0)
    flow reconcile: this.to_reconcile -> this.work_done @balances_stocks_work
        "The team reconciles the records that it must check again."
        request = formula(this.pace if this.state == RECONCILING or this.state == RECONCILING_AGAINST_PRODUCT else 0)
        capacity = formula(this.pace if this.state == RECONCILING or this.state == RECONCILING_AGAINST_PRODUCT else 0)
    ordinary_work_done = event(): @service_recovery
        "Qualification work finishes and the records review begins."
        when this.state == QUALIFYING and this.ordinary_left <= 0 and records.state == REVIEW:
            this.ordinary_work_done.start()
        after 0 h:
            this.state = RECONCILING
    ready_without_changes = event(): @service_recovery
        "The team completes qualification with no pending review."
        when this.state == QUALIFYING and this.ordinary_left <= 0 and records.state != REVIEW:
            this.ready_without_changes.start()
        after 0 h:
            this.state = READY
    changes_found_in_review = event(): @product_reconciliation
        "The procurement review adds work after qualification."
        when this.state == READY and records.state == REVIEW:
            this.changes_found_in_review.start()
        after 0 h:
            this.state = RECONCILING
    work_ready = event(): @product_reconciliation
        "All pending review work has been completed."
        when this.state == RECONCILING and this.to_reconcile <= 0:
            this.work_ready.start()
        after 0 h:
            this.state = READY
            records.state = RECONCILED
    restart_release = event(): @qualification_release_come
        "Work, procurement and containment are ready. The first qualified lot is released."
        when this.state == READY and this.to_reconcile <= 0 and hospitals.procurement == EMERGENCY and manufacturer.release_allowed and release_systems.containment == COMPLETE:
            this.restart_release.start()
        after 0 h:
            this.state = RELEASED
            deliveries.state = ON_THE_WAY
            if records.released_lot == NEEDS_CHECK:
                records.state = PENDING_CHECK
        after records.sample_delay:
            if records.state == PENDING_CHECK:
                records.review_pending.start()
    reconciled_against_product = event(): @product_reconciliation
        "Product reconciliation and records recovery are complete. Replacement lots can be shipped."
        when this.state == RECONCILING_AGAINST_PRODUCT and this.to_reconcile <= 0 and release_systems.records_service == COMPLETE:
            this.reconciled_against_product.start()
        after 0 h:
            this.state = RELEASED
            records.state = RECONCILED

resuscitation_reserve: @a_pilot_assumed_brief
    "The hospitals' reserve of IV fluid for resuscitation. Resuscitation patients draw on it, and other
        makers' fluid comes into it until released fluid arrives."
    readonly daily_need = 600 L/day @rt_sector_2026_assumes_l_day
        "Daily fluid need for resuscitation"
    state: enum[STOCKED, EMPTY] = STOCKED
        "Resuscitation fluid reserve"
    stock: L = hospitals.days_on_hand * this.daily_need in [0,] scale 9000 L @balances_fluid_stocks
    used: L = 0 scale 36000 L @balances_fluid_stocks
    held: L = 0 scale 9000 L
        @assumption "Resuscitation fluid from held lots that hospitals set aside; it stays out of use for the
            rest of the study period."
            claims:
                E-IV-CGMP-DATA-INTEGRITY
                SC10-SUPPLY-CONSERVATION
    readonly need: formula(L/h) = formula(this.daily_need if release_systems.state != RESTORED else 0 L/h)
        @balances_fluid_stocks
    readonly use_rate: formula(L/h) = formula(this.need if this.state == STOCKED or deliveries.state == ARRIVING else other_makers.supply_rate) @balances_fluid_stocks
    readonly unmet_rate: formula(L/h) = formula(max(0, this.need - this.use_rate)) @balances_fluid_stocks
    deficit: L = 0 scale 18000 L @balances_fluid_stocks
        "Resuscitation fluid not supplied"
    flow add_deficit: SOURCE -> this.deficit @balances_fluid_stocks
        request = formula(this.unmet_rate)
        capacity = formula(this.unmet_rate)
    status failed when this.unmet_rate > 0
        "Not enough fluid for current demand"
    status ok when this.state == EMPTY
        "Reserve used up; released fluid meets current demand"
    status ok
        "Reserve meets current demand"
    runs_out = event(): @a_pilot_assumed_brief @card_text_pilot
        "Hospitals run out of the fluid kept for resuscitation; other makers' supply covers only part of the
            need."
        when this.state == STOCKED and this.stock <= 0:
            this.runs_out.start()
        after 0 h:
            this.state = EMPTY
    courses_missed = event(): @a_pilot_assumed_brief
        "Some resuscitation patients miss a complete course of IV fluid; the most fluid-dependent die unless
            outside supply or a transfer reaches them in time."
        @assumption "This text describes, in plain words, the event that the model calculates."
            assumption A-SC10-CONSEQUENCES-2026
        when this.state == EMPTY and deliveries.state != ARRIVING and release_systems.state != RESTORED:
            this.courses_missed.start()
            reset when false

other_care_reserve: @a_pilot_assumed_brief
    "The hospitals' reserve of IV fluid for other essential care, such as procedures that need it. Hospitals
        postpone those procedures while the reserve is empty and no released fluid arrives."
    readonly daily_need = 600 L/day @rt_sector_2026_assumes_l_day
        "Daily fluid need for other essential care"
    state: enum[STOCKED, EMPTY] = STOCKED
        "Fluid reserve for other essential care"
    stock: L = hospitals.days_on_hand * this.daily_need in [0,] scale 9000 L @balances_fluid_stocks
    used: L = 0 scale 36000 L @balances_fluid_stocks
    held: L = 0 scale 9000 L
        @assumption "Other essential-care fluid from held lots that hospitals set aside; it stays out of use
            for the rest of the study period."
            claims:
                E-IV-CGMP-DATA-INTEGRITY
                SC10-SUPPLY-CONSERVATION
    readonly need: formula(L/h) = formula(this.daily_need if release_systems.state != RESTORED else 0 L/h)
        @balances_fluid_stocks
    readonly use_rate: formula(L/h) = formula(this.need if this.state == STOCKED or deliveries.state == ARRIVING else 0 L/h)
        @balances_fluid_stocks
    readonly unmet_rate: formula(L/h) = formula(max(0, this.need - this.use_rate)) @balances_fluid_stocks
    deficit: L = 0 scale 36000 L @balances_fluid_stocks
        "Fluid for other essential care not supplied"
    flow add_deficit: SOURCE -> this.deficit @balances_fluid_stocks
        request = formula(this.unmet_rate)
        capacity = formula(this.unmet_rate)
    shortage_days: formula(days) = formula(this.deficit / this.daily_need) in [0,]
        "Days without fluid for other essential care"
        @identity "The outcome divides the unmet litres for other essential care by the daily need for other
            care. While that reserve is empty and no released fluid arrives, the whole need goes unmet. So
            each day short adds one day of demand."
    status failed when this.unmet_rate > 0
        "Not enough fluid for current demand"
    status ok when this.state == EMPTY
        "Reserve used up; released fluid meets current demand"
    status ok
        "Reserve meets current demand"
    flow use: this.stock -> this.used @balances_fluid_stocks
        "Hospitals use the fluid for other essential care."
        request = formula(this.use_rate)
        capacity = formula(this.use_rate)
    runs_out = event(): @a_pilot_assumed_brief @card_text_pilot
        "Hospitals run out of the fluid kept for other essential care."
        when this.state == STOCKED and this.stock <= 0:
            this.runs_out.start()
        after 0 h:
            this.state = EMPTY
    procedures_postponed = event(): @a_pilot_assumed_brief @card_text_pilot
        "Hospitals postpone procedures that need IV fluid until supply returns."
        when this.state == EMPTY and deliveries.state != ARRIVING and release_systems.state != RESTORED:
            this.procedures_postponed.start()
            reset when false

other_makers: @a_pilot_assumed_brief
    "Other makers of IV fluid. Their supply goes to the resuscitation reserve until released fluid arrives,
        and to hospitals elsewhere after that."
    input daily_supply = 480 L/day in [360 L/day, 590 L/day]
        "Daily supply from other makers"
        @assumption "The scenario assumes 480 L/day. Published incidents show how this works, but only under
            the conditions that they observed. The range of values used to test this input is also an
            assumption."
            assumption RT-SECTOR-SC10-2026
    readonly supply_rate: formula(L/h) = formula(this.daily_supply if release_systems.state != RESTORED else 0 L/h)
        @balances_fluid_stocks
    readonly to_hospitals_rate: formula(L/h) = formula(this.supply_rate if deliveries.state != ARRIVING else 0 L/h)
        @balances_fluid_stocks
    readonly elsewhere_rate: formula(L/h) = formula(this.supply_rate if deliveries.state == ARRIVING else 0 L/h)
        @balances_fluid_stocks
    buffer: L = 0 in [0,] scale 480 L @balances_fluid_stocks
        outflow.capacity = formula(this.supply_rate) @balances_fluid_stocks
        outflow.allocation = priority(this.to_hospitals, this.elsewhere)
    supply_left: L = this.daily_supply * manufacturer.study_length in [0,] scale 28800 L @balances_stocks_work
    sent_elsewhere: L = 0 scale 28800 L
        @identity "Other makers' surplus fluid that leaves the study hospitals goes here. This fluid cannot
            come back for use with patients in the model, and it gets no credit for recovery."
    status ok
        "Supplies fluid for resuscitation"
    flow supply: this.supply_left -> this.buffer @balances_fluid_stocks
        "Other makers' fluid arrives at their daily rate."
        request = formula(this.supply_rate)
        capacity = formula(this.supply_rate)
    flow to_hospitals: this.buffer -> resuscitation_reserve.stock @balances_fluid_stocks
        "Other makers' fluid goes to the resuscitation reserve."
        request = formula(this.to_hospitals_rate)
        capacity = formula(this.to_hospitals_rate)
    flow elsewhere: this.buffer -> this.sent_elsewhere @balances_fluid_stocks
        "Other makers' fluid goes to hospitals elsewhere once released fluid arrives."
        request = formula(this.elsewhere_rate)
        capacity = formula(this.elsewhere_rate)

deliveries: @a_pilot_assumed_brief
    "The fluid that the manufacturer releases. It reaches the hospitals a day after release, and each of the
        two reserves gets half of it."
    @assumption "Released fluid reaches the hospitals a day after release; lots released on altered records
        are held once the changes are found, and deliveries resume a day after release restarts."
        claims:
            E-IV-CGMP-DATA-INTEGRITY
            SC10-SUPPLY-CONSERVATION
    readonly daily_supply = 1200 L/day
        "Daily supply once deliveries resume"
        @assumption "The scenario assumes 1200 L/day. Published incidents show how this works, but only under
            the conditions that they observed. The range of values used to test this input is also an
            assumption."
            assumption RT-SECTOR-SC10-2026
    readonly lead_time = 24 h
        "Shipping time after release"
        @assumption "The scenario assumes 24 h. The range of values used to test this input is also an
            assumption."
            assumption RT-SECTOR-SC10-2026
            claims:
                E-BAXTER24DEC-LAG
    input shipping_cost = 1000000 USD2025 in [0 USD2025, 100000000 USD2025]
        "Cost of shipping released fluid"
        @assumption "The scenario assumes an extra shipping cost of one million dollars, counted when the
            fluid physically arrives."
            assumption A-SC10-CONSEQUENCES-2026
    state: enum[AWAITING_RELEASE, ON_THE_WAY, ARRIVING, HELD] = AWAITING_RELEASE
        "Released fluid"
    readonly earliest_receipt: formula(h) = formula(max(hospitals.start_delay, (release_team.ordinary_work + release_team.records_work) / release_team.pace, manufacturer.containment_time) + this.lead_time)
        @qualification_release_come
    supply_left: L = this.daily_supply * (manufacturer.study_length if records.initial_review == ADDITIONAL or records.released_lot == NEEDS_CHECK else max(0 h, manufacturer.study_length - this.earliest_receipt)) in [0,] scale 72000 L @balances_stocks_work
        outflow.capacity = formula(2 * this.delivery_rate) @balances_fluid_stocks
    readonly half_supply: formula(L/h) = formula(this.daily_supply / 2) @balances_fluid_stocks
    readonly delivery_rate: formula(L/h) = formula(this.half_supply if this.state == ARRIVING and release_systems.state != RESTORED else 0 L/h) @balances_fluid_stocks

    readonly received_each: formula(L) = formula((this.daily_supply * manufacturer.study_length - this.supply_left) / 2)
        @identity "Released fluid each reserve has received so far: half of what the deliveries drew."
    shipping_loss: formula(USD2025_bn) = formula(this.shipping_cost if this.state == ARRIVING or this.state == HELD else 0 USD2025) in [0,] @counts_fixed_group
        "Cost of shipping released fluid"
    status ok when this.state == ARRIVING
        "Released fluid meets demand"
    status degraded when this.state == ON_THE_WAY
        "Released; first deliveries on the way"
    status failed when this.state == HELD
        "Lots released on altered records are on hold"
    status inactive
        "No released fluid yet"
    flow to_resuscitation: this.supply_left -> resuscitation_reserve.stock @balances_fluid_stocks
        "Released fluid goes to the resuscitation reserve."
        request = formula(this.delivery_rate)
        capacity = formula(this.delivery_rate)
    flow to_other_care: this.supply_left -> other_care_reserve.stock @balances_fluid_stocks
        "Released fluid goes to the reserve for other essential care."
        request = formula(this.delivery_rate)
        capacity = formula(this.delivery_rate)

    first_arrival = event():
        "Released fluid begins to reach the hospitals and meets demand; other makers' fluid goes back to
            hospitals elsewhere."
        @a_pilot_assumed_brief
        @assumption "Released fluid reaches the hospitals one day after release."
            assumption A-SC10-pilot
            claims:
                E-BAXTER24DEC-LAG
        when count(release_team.restart_release.occurrences) > 0 and since(release_team.restart_release) >= this.lead_time:
            this.first_arrival.start()
            reset when false
        after 0 h:
            this.state = ARRIVING
    arrival_after_reconciliation = event():
        "With its records reconciled against the product, the manufacturer restarts release, and fluid reaches
            the hospitals again."
        @source_transfer "As before, released fluid reaches the hospitals one day after release."
            claims:
                SC10-PROCESS-QUALIFICATION
        when count(release_team.reconciled_against_product.occurrences) > 0 and since(release_team.reconciled_against_product) >= this.lead_time:
            this.arrival_after_reconciliation.start()
            reset when false
        after 0 h:
            this.state = ARRIVING

resuscitation_patients: @a_pilot_assumed_brief
    "The patients who need one urgent course of IV fluid for resuscitation over the study period, each counted
        once."
    input course_volume = 2 L/people in [1 L/people, 3 L/people]
        "Fluid per resuscitation patient"
        @assumption "The scenario assumes 2 L per patient. Published incidents show how this works, but only
            under the conditions that they observed. The range of values used to test this input is also an
            assumption."
            assumption RT-SECTOR-SC10-2026
    readonly total: formula(people) = formula(resuscitation_reserve.daily_need * manufacturer.study_length / this.course_volume)
        @balances_fluid_stocks
    readonly course_rate: formula(people/h) = formula(resuscitation_reserve.daily_need / this.course_volume if release_systems.state != RESTORED else 0 people/h) @balances_fluid_stocks
    readonly miss_rate: formula(people/h) = formula(resuscitation_reserve.unmet_rate / this.course_volume) @balances_fluid_stocks
    eligible: people = this.total in [0,] scale 18000 people @balances_fluid_stocks
        outflow.capacity = formula(this.course_rate) @a_pilot_assumed_brief
    timely: people = 0 scale 18000 people @balances_fluid_stocks
    unserved: people = 0 scale 18000 people @keeps_count_limited
        "Complete resuscitation courses missed"
    status failed when resuscitation_reserve.unmet_rate > 0
        "Not enough fluid for complete courses"
    status ok
        "Complete courses supplied"
    flow complete_course:
        "Resuscitation patients get a complete course of fluid from the reserve."
        @balances_fluid_stocks @a_pilot_assumed_brief
        flow resuscitation_reserve_used: resuscitation_reserve.stock -> resuscitation_reserve.used
            request = formula(resuscitation_reserve.use_rate)
        flow timely: this.eligible -> this.timely
            request = formula(resuscitation_reserve.use_rate / this.course_volume)
    flow miss_course: this.eligible -> this.unserved @keeps_count_limited
        "Resuscitation patients miss a complete course when the reserve cannot supply one."
        request = formula(this.miss_rate)
        capacity = formula(this.miss_rate)
    assert this.eligible + this.timely + this.unserved in [this.total - 1e-05 people, this.total + 1e-05 people] @balances_fluid_stocks
        "Each patient in the model is in exactly one group, alive or dead, and the groups do not overlap."

high_risk_patients:
    "The most fluid-dependent resuscitation patients, with severe dehydration. Each of them who misses a
        complete course is rescued or not rescued."
    input share: fraction = 0.1 in [0, 1]
        "Share of resuscitation patients with fluid-dependent severe dehydration"
        @assumption "The scenario assumes that 10% of patients who need an urgent course have severe
            dehydration and depend on IV fluid. The default 2 L course is a first rehydration of 100 mL/kg for
            a 20 kg patient. A different course volume stands for a patient whose weight matches it. The other
            patients receive the substitute care that the scenario sets out."
            assumption A-SC10-CONSEQUENCES-2026
    input untreated_risk: fraction = 0.5 in [0, 1]
        "Risk of death from severe dehydration without effective rehydration"
        @assumption "The WHO-hosted Uganda guideline reports that more than 50% of cholera patients with
            severe dehydration die without treatment. For patients with severe dehydration, the scenario uses
            0.50."
            assumption A-SC10-CONSEQUENCES-2026
    input treated_risk: fraction = 0.01 in [0, 1]
        "Risk of death from severe dehydration with effective rehydration"
        @assumption "The WHO-hosted Uganda guideline reports that fewer than 1% die with correct treatment.
            The scenario uses 0.01 as the reference. The model subtracts it, so that it counts only the deaths
            above this risk."
            assumption A-SC10-CONSEQUENCES-2026
    input serious_share: fraction = 0.1 in [0, 0.5]
        "Share of unrescued high-risk patients left with serious harm"
        @assumption "The scenario assumes an added 0.10 probability of survival with serious kidney failure or
            shock. It applies to each high-risk patient who misses a course and is not rescued. Clinical
            evidence shows how such harm happens, but the probability itself is an input for sensitivity
            tests."
            assumption A-SC10-CONSEQUENCES-2026
    input harm_delay = 6 h in [1 h, 24 h]
        "Time from a missed course to death or serious harm"
        @assumption "The scenario assumes that death or serious harm comes six hours after a missed complete
            urgent course. Severe dehydration gets worse over hours."
            assumption A-SC10-CONSEQUENCES-2026
    readonly unmet_rate: formula(people/h) = formula(this.share * resuscitation_patients.miss_rate) @counts_fixed_group
    readonly rescue_rate: formula(people/h) = formula(min(this.unmet_rate, hospitals.rescue_capacity) if hospitals.procurement == EMERGENCY else 0 people/h) @counts_fixed_group
    eligible: people = this.share * resuscitation_patients.total in [0,] scale 1800 people
        @identity "The fixed group of high-risk patients splits into patients who are rescued and patients who
            are not."
        outflow.capacity = formula(this.unmet_rate) @high_risk_patient
        outflow.allocation = priority(this.rescue, this.not_rescued)
    rescued: people = 0 scale 1800 people @counts_fixed_group
        "Most fluid-dependent patients rescued after a missed course"
    unresolved: people = 0 scale 1800 people @counts_fixed_group
        "Most fluid-dependent patients who miss a course and are not rescued"
    deaths: formula(people) = formula(this.unresolved * (this.untreated_risk - this.treated_risk)) in [0,]
        "Deaths"
        @a_consequences_2026_three_inputs_turn
    serious_survivors: formula(people) = formula(this.unresolved * this.serious_share) in [0,] @a_consequences_2026_three_inputs_turn
        "Survivors left with serious harm"
    casualties: formula(people) = formula(this.deaths + this.serious_survivors) in [0,] @distinct_people
        "Serious casualties, including deaths"
        @a_consequences_2026_three_inputs_turn @distinct_people @hazus_severity
    flow rescue: this.eligible -> this.rescued @high_risk_patient
        "Outside supply or a transfer rescues a high-risk patient who misses a course."
        request = formula(this.rescue_rate)
        capacity = formula(this.rescue_rate)
    flow not_rescued: this.eligible -> this.unresolved @high_risk_patient
        "A high-risk patient who misses a course is not rescued."
        request = formula(this.unmet_rate)
        capacity = formula(this.unmet_rate)
    assert this.eligible + this.rescued + this.unresolved in [this.share * resuscitation_patients.total - 1e-05 people, this.share * resuscitation_patients.total + 1e-05 people]
        "Each high-risk patient who really misses a complete course goes into one group only: rescued or not
            rescued."
        @counts_fixed_group

assert other_makers.daily_supply >= 0 and other_makers.daily_supply <= resuscitation_reserve.daily_need
    "Daily supply from other makers is not more than the daily fluid need for resuscitation."
    @a_pilot_assumed_brief

assert deliveries.daily_supply / 2 == resuscitation_reserve.daily_need and deliveries.daily_supply / 2 == other_care_reserve.daily_need @a_pilot_assumed_brief
    "The scenario splits released fluid equally between resuscitation and other essential care, and each half
        meets its daily need."

assert manufacturer.study_length == 1440 h @a_pilot_assumed_brief
    "The patient numbers and the manufacturer's losses cover the 60-day study period chosen for this scenario."

assert deliveries.earliest_receipt <= manufacturer.study_length @keeps_count_limited
    "The work, procurement and delivery times chosen for this scenario fit within the study period."

assert high_risk_patients.untreated_risk >= high_risk_patients.treated_risk and high_risk_patients.untreated_risk + high_risk_patients.serious_share <= 1 @counts_fixed_group
    "Among patients who are not rescued, deaths and survivors with serious harm are separate groups that
        together are not more than all of these patients. The model counts only deaths above the death risk
        with treatment."

assert hospitals.days_on_hand * (resuscitation_reserve.daily_need + other_care_reserve.daily_need) + other_makers.daily_supply * manufacturer.study_length + deliveries.daily_supply * (manufacturer.study_length if records.initial_review == ADDITIONAL or records.released_lot == NEEDS_CHECK else manufacturer.study_length - deliveries.earliest_receipt) - resuscitation_reserve.stock - other_care_reserve.stock - resuscitation_reserve.held - other_care_reserve.held - other_makers.buffer - other_makers.supply_left - deliveries.supply_left - resuscitation_reserve.used - other_care_reserve.used - other_makers.sent_elsewhere in [-1e-05 L, 1e-05 L] @balances_fluid_stocks
    "The total litres stay constant. They are in the planned supplies, the hospital reserves, the held lots,
        the fluid given to patients and the fluid sent to hospitals elsewhere."
    @identity "The model balances the fluid stocks, including fluid set aside from held lots."

assert release_team.ordinary_left + release_team.reserve + release_team.to_reconcile + release_team.work_done - release_team.ordinary_work - release_team.records_work - (release_team.product_work if records.initial_review == ADDITIONAL or records.released_lot == NEEDS_CHECK else 0 work_h) in [-1e-05 work_h, 1e-05 work_h] @balances_stocks_work
    "The ordinary work at the start, plus the reconciliation reserve, equals the sum of ordinary work left,
        unused reserve, reconciliation to do and work done."
    @identity "The model balances the work, with the reserve of reconciliation work set for this scenario."

fluid_sent_elsewhere: formula(L) = formula(other_makers.sent_elsewhere) in [0,] @balances_fluid_stocks
    "Other makers' fluid sent to hospitals elsewhere"

procedure_loss: formula(USD2025_bn) = formula(other_care_reserve.deficit / hospitals.procedure_volume * hospitals.procedure_value) in [0,] @counts_fixed_group
    "Hospital value permanently lost from postponed procedures"

loss_bn: formula(USD2025_bn) = formula(manufacturer.output_loss + manufacturer.recovery_loss + deliveries.shipping_loss + procedure_loss) in [0,]
    "Economic loss"
    @assumption "The loss adds separate costs: money spent on resources and net value added that is
        permanently lost. Deaths are a separate outcome, counted in people."
        assumption A-SC10-CONSEQUENCES-2026

people_needing_courses: formula(people) = formula(resuscitation_patients.total) in [0,] @counts_fixed_group
    "Patients who need an urgent course, each counted once"

timely_courses: formula(people) = formula(resuscitation_patients.timely) in [0,] @keeps_count_limited
    "Complete courses supplied on time"

release_work_done: formula(work_h) = formula(release_team.work_done) in [0,] @keeps_count_limited
    "Qualification and reconciliation work completed"

options "Response":
    "Early response":
        "Early emergency procurement, rapid qualification work and early containment. The records system is
            remediated at restart. Effective rescue is available to up to 30 patients per day."
        manufacturer.containment_time = 72 h @containment_time
        manufacturer.reset_delay = 0 h @reset_delay
        hospitals.start_delay = 24 h @start_delay
        hospitals.rescue_capacity = 30 people/day @rescue_capacity
        release_team.pace = 2 work_h/h @pace
    "Standard response":
        "Standard procurement, qualification, remediation and patient rescue."
    "Limited response":
        "Later procurement and containment, slower qualification and no outside rescue."
        manufacturer.containment_time = 720 h @containment_time
        manufacturer.reset_delay = 168 h @reset_delay
        hospitals.start_delay = 168 h @start_delay
        hospitals.rescue_capacity = 0 people/day @rescue_capacity
        release_team.pace = 0.6 work_h/h @pace

options "Qualification":
    "Routine records":
        "The manufacturer expects only the routine qualification work."
    "Additional records":
        "The procurement review adds a finite records-reconciliation task to the qualification queue."
        records.initial_review = ADDITIONAL
        release_team.records_work = 168 work_h @records_work

options "First released lot":
    "Clear":
        "The first lot passes product review."
    "Review needed":
        "The first lot requires a product check. A confirmed discrepancy puts affected fluid on hold."
        records.released_lot = NEEDS_CHECK

runs:
    near_ideal = "Early response" + "Routine records" + "Clear"
    subpar = "Standard response" + "Routine records" + "Clear"
    minimal = "Limited response" + "Routine records" + "Clear"
    subpar_persistent = "Standard response" + "Additional records" + "Review needed"
        "Standard response with records and product review"
    subpar_persistent_human = "Standard response" + "Additional records" + "Clear"
        "Standard response with records review and a clear first lot"
    near_ideal_persistent = "Early response" + "Additional records" + "Clear"
    minimal_persistent = "Limited response" + "Additional records" + "Review needed"

notes:
    premises:
        START: "Published incidents document disruption of production and order fulfilment. Parameters for this hypothetical manufacturer and hospital network are scenario assumptions."
    limitations:
        clinical-transfer: "The scenario assumes that 10% of the patients who need an urgent course are high-risk. It applies to these fluid-dependent patients the difference in death risk, with and without rehydration, seen for severe dehydration in cholera. The clinical mix, the patient weight that an urgent course matches, effective rescue and the risk of serious harm in survivors need local patient data."
        no-precedent: "The persistent condition, its timing, the affected lots and the health consequences are scenario assumptions. They are used to study continuity of supply."
    verification:
        status: "conditional_calculation"
        research: "evidence/research.md"
        population: "The scenario gives the number of people in each group that the study follows. No person is in two groups"
        calibration: "Each value that a source reports, and each source value that the scenario chose to apply here, keeps its own source"
        accounting: "Serious casualties are the people who die or are seriously hurt, each person counted once. Economic loss adds the extra costs that the incident causes, in the accounts that the scenario names. No cost is in two accounts"
        reproduction: "Each complete report keeps the inputs that the calculation used, the time that the results cover and the versions of the model and the library"
    counterfactual: "Under the same standard response and qualification work, compare a first lot needing product review with a clear first lot."
    decisive: "First-lot quality is specified at release. The independent check, finite work queue and shipping lead time determine when fluid becomes available again."
    reporting:
        manufacturer:
            hours_out:
                scope: "The fixed set of stocks and resources chosen for this scenario."
            output_loss:
                scope: "The manufacturer's net production value added that is permanently lost, in US dollars at 2025 prices."
            recovery_loss:
                scope: "Extra money spent on resources, counted once after the manufacturer is disrupted."
        resuscitation_reserve:
            deficit:
                scope: "Litres of resuscitation need that go unmet because of the incident, across the 100 hospitals. Resuscitation has its own separate reserve."
        other_care_reserve:
            deficit:
                scope: "Litres of other essential-care need that go unmet across the 100 hospitals chosen for this scenario. The model does not turn these litres into clinical harm until a validated model of these patients exists."
            shortage_days:
                about: "Days during which hospitals have no IV fluid for other essential care, such as procedures that need it, which are postponed until supply returns. It leaves out resuscitation, which other makers' supply partly covers and whose missed courses are counted separately."
                scope: "Days when other essential-care needs go unmet across the 100 hospitals chosen for this scenario, over the 60-day study period."
        deliveries:
            shipping_loss:
                scope: "Extra shipping cost, counted once when fluid first arrives."
        resuscitation_patients:
            unserved:
                scope: "Each eligible person counts once, with one complete course. This count estimates how many courses the hospitals fail to supply."
        high_risk_patients:
            rescued:
                scope: "High-risk patients, each counted once, who get effective outside rehydration or a transfer in time for urgent treatment."
            unresolved:
                scope: "The high-risk share, chosen for this scenario, of the complete urgent courses that are actually missed."
            deaths:
                about: "Deaths among the most fluid-dependent resuscitation patients, those with severe dehydration. Only patients who miss a complete course of IV fluid and are not saved by outside supply or transfer count. For each of them, the model adds the death risk without effective rehydration minus the risk with it. It counts these deaths over the 60-day study period. It leaves out deaths among other patients, any harm from postponed procedures and any harm from fluid released on altered records. These are expected numbers and can fall below one."
                scope: "Patients who need an urgent course in the 100 hospitals, each counted once, as chosen for this scenario. The death risk is the risk for severe dehydration. The outcome follows six hours after the missed course."
                category: deaths
                lag: "high_risk_patients.harm_delay"
            serious_survivors:
                scope: "Survivors left with serious kidney failure or shock, in addition to the deaths, each counted once. The rate is chosen for this scenario."
                lag: "high_risk_patients.harm_delay"
            casualties:
                about: "Those deaths plus patients who survive but are left with serious kidney failure or shock after a missed course. Each person is counted once. Postponed procedures are not counted as casualties. These are expected numbers and can fall below one."
                scope: "Deaths and survivors with serious harm, each person counted once, among the patients in this scenario who need urgent fluid."
                category: casualties
                lag: "high_risk_patients.harm_delay"
        fluid_sent_elsewhere:
            scope: "Litres of other makers' fluid sent to hospitals outside the study area after released fluid arrives. The model cannot use this fluid for patients again, and it gives no credit for recovery."
        procedure_loss:
            scope: "Hospital value added permanently lost from postponed other-care procedures, at a value chosen for this scenario."
        loss_bn:
            about: "This is the manufacturer's value added lost over the whole 60-day study period, plus its cyber recovery costs. It also adds the cost of shipping released fluid and the value permanently lost from postponed procedures. All amounts are in 2025 US dollars. It leaves out the cost to hold and check suspect lots, the fluid set aside, extra treatment costs and any money value of lives lost."
            scope: "The manufacturer's lost value added, its recovery costs, the cost of shipping released fluid and hospital value added permanently lost from procedures. All are in US dollars at 2025 prices."
            category: loss
        people_needing_courses:
            scope: "The model gives one urgent course to each person in the patient group over the 60-day study period. Repeated episodes would need a separate patient group, set up for them."
        timely_courses:
            scope: "The fixed set of stocks and resources chosen for this scenario."
        release_work_done:
            about: "Work-hours that release staff spend to qualify lots and reconcile their records before the lots can ship. This includes work done again after altered records are found."
            scope: "The fixed set of stocks and resources chosen for this scenario."
    comparisons:
        subpar_persistent_human: subpar_persistent

record a_pilot_assumed_brief: assumption "Assumed for this scenario, from the scenario brief."
    assumption A-SC10-pilot
record balances_fluid_stocks: identity "The model balances the fluid stocks or counts each patient in one
    group only. It uses the stated assumptions of this pilot scenario."
record counts_fixed_group: identity "The model counts a fixed group of people and gives all costs at one price
    year. It uses the inputs recorded for this scenario."
record keeps_count_limited: identity "The model keeps a count of each limited stock of physical items. Items
    move between stocks and work adds up over time, but no item is created or lost."
record balances_stocks_work: identity "The model balances stocks, work done and transfers, so that no quantity
    is created or lost."
record rt_sector_2026_assumes_l_day: assumption "The scenario assumes 600 L/day. Published incidents show how
    this works, but only under the conditions that they observed. The range of values used to test this input
    is also an assumption."
    assumption RT-SECTOR-SC10-2026
record card_text_pilot: assumption "This text describes, in plain words, the event that the model calculates."
    assumption A-SC10-pilot
record reset_delay: assumption "Time needed after release restarts to restore the records service. The team
    requires that service to release replacement lots after a product hold."
record found_by_product_check: assumption "Time from the start of the product check to confirmation of the lot
    discrepancy."
record start_delay: assumption "Hospital procurement starts after an assumed response delay. Once procurement
    starts, hospitals can draw on transfer and rescue capacity."
record rescue_capacity: assumption "Outside IV supply or transfer to another hospital saves this many of the
    most fluid-dependent patients a day, once procurement starts. These are the patients with severe
    dehydration. The numbers are 30, 10 and none in the early, standard and limited responses. Without
    effective rehydration about half of them die."
    assumption A-SC10-CONSEQUENCES-2026
record qualification_release_come: source_transfer "Qualification and release come before use. The fixed
    24-hour delivery time is an assumption of this pilot scenario."
    claims:
        SC10-PROCESS-QUALIFICATION
record records_work: assumption "Additional records review consumes a finite amount of the release team’s work
    capacity."
    assumption RT-SC10-INTEGRITY-REVERIFY
record pace: assumption "How fast the manufacturer restores its systems, requalifies release and reconciles
    its records. The pace is twice the standard pace, the standard pace and 60% of it in the early, standard
    and limited responses. At the standard pace the ordinary work takes three weeks. One work-hour an hour is
    one work-hour of progress each hour: the work of one full-time team on this task."
    assumption RT-SECTOR-SC10-2026
record product_reconciliation: assumption "When a product check finds a discrepancy, affected lots are held
    until the records are reconciled against the product."
    claims:
        E-IV-CGMP-DATA-INTEGRITY
        GENERIC-RECOVERY-INTEGRITY
record high_risk_patient: identity "Each high-risk patient who misses a complete course goes into one of two
    groups. Rescue comes first, up to its daily capacity, and the other patients are not rescued."
record a_consequences_2026_three_inputs_turn: assumption "Three inputs turn missed complete courses into harm.
    They are the share with severe dehydration chosen for this scenario, the stated rescue capacity and the
    source's difference in risk with and without rehydration. Deaths count only the risk above that with
    timely rehydration."
    assumption A-SC10-CONSEQUENCES-2026
record distinct_people: assumption "Each unique person has one complete urgent course, so the deaths and the
    serious survivors are different people."
    assumption A-SC10-CONSEQUENCES-2026
record hazus_severity: convention "Serious casualties are the people who die and the people who survive with
    serious harm that lasts: the Hazus severity levels S4 and S3."
    convention HAZUS-SEVERITY
record service_recovery: assumption "A disruption pauses qualified shipments. The response assumptions
    determine the time to contain the incident, restore the records service and procure fluid."
    claims:
        E-NHSBT24-AMBER
        E-NHSBT25-STANDDOWN
        E-NYBCE25-MUTUALAID
        E-CYBERSCOOP20-FRESENIUS-PRODUCTION
        E-OCTA24-CLOSURE
        E-SUNPHARMA23-AUDIT
        E-UNH24-PHARMACY-RESTORE
record qualification_work: assumption "The team completes ordinary qualification work first and then processes
    pending records review at its declared pace."
record containment_time: assumption "Initial containment must complete before release can resume."
