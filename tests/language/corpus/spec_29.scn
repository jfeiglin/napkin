deliver = event(amount: L, target_rate: L/h, setup: h):
    batch: L = 0 L in [0 L, amount]
    flow delivery: batch -> this.customer.water
        request = 0 L/h

    after 0 h:
        move amount from this.supply to batch

    after setup:
        delivery.request = target_rate

    until batch <= 0 L
