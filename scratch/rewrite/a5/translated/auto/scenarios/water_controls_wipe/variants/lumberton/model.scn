# Water systems' controls wiped through a shared remote-support platform: Lumberton, North Carolina
variant "Lumberton, North Carolina"
    summary "An AI agent wipes the controls of the water system of Lumberton, North Carolina through the
        remote-support platform of the OT integrator that it uses."
    scope "The people that the water system of Lumberton, North Carolina serves, the hospitals that it
        supplies and the businesses that need public water there."

lumberton: Utility
    "City of Lumberton, North Carolina. Its ID in the federal inventory is NC0378010."
    title "Lumberton"
    buys = <>
    sells = <>
    name = "Lumberton"
    demand = 5.4286 Mgal/day  @lumberton_demand
    nameplate = 16 Mgal/day  @lumberton_nameplate
    storage = 7.5 Mgal  @lumberton_storage
    bought = 0 Mgal/day  @lumberton_bought
    sold = 0 Mgal/day  @lumberton_sold
    va_rate = 121870.86 USD2025/h  @lumberton_va_rate

lumberton_homes: Households
    "The people that Lumberton serves."
    title "Lumberton: homes"
    utility = lumberton
    population = 24460 people  @lumberton_homes_population

lumberton_hospitals: Hospitals
    "The hospital that Lumberton supplies: Southeastern Regional Medical Center."
    title "Lumberton: hospitals"
    utility = lumberton
    name = "Lumberton"
    facilities = 1 facilities  @lumberton_hospitals_facilities

notes:
    limitations:
        process-water: "About 2.2 of Lumberton's 4.58 Mgal a day is process water for backwash, line cleaning
            and flushing. The model draws the stored water at the full daily use, so the stored water can run
            out sooner here than in fact."  @lumberton_demand
        emergency-connection: "The emergency connection with Robeson County can supply up to 0.5 Mgal a day.
            The model gives Lumberton none of this water during the event, so its interruption can be longer
            here than in fact."  @lumberton_bought
    verification:
        research: "variants/lumberton/evidence/research.md"

record lumberton_demand: assumption "Highest maximum day of 2025, 5.7 Mgal/day (January, June and December;
    1.2454 times the 2025 total demand of 4.5767). Lumberton sold no water in 2025, so nothing is removed;
    divided by 1.05: 5.7 / 1.05 = 5.4286 Mgal/day. The 2018 day (8.5 Mgal/day) is left out because the 2018
    plan says those raw-water figures were double-counted."
    assumption A-SC43-PEAK-DAY
    claims:
        E-SC43-LUMBERTON-CITY-USE
        E-SC43-LUMBERTON-CITY-INTERCONNECT
        E-SC43-LUMBERTON-CITY-RAW-2018

record lumberton_nameplate: source "Permitted capacity of the one plant, the City of Lumberton Water Plant on
    the Lumber River. The wells feed raw water into the same plant (2018 plan), so they add supply, not
    treatment capacity."
    claims:
        E-SC43-LUMBERTON-CITY-CAPACITY
            datum: plant_capacity
        E-SC43-LUMBERTON-CITY-RAW-2018

record lumberton_storage: source "Finished water storage capacity reported in the 2025 plan, 7.5 Mgal (the 16
    Mgal of off-stream raw water storage is not counted)."
    claims:
        E-SC43-LUMBERTON-CITY-STORAGE
            datum: finished_storage

record lumberton_bought: source "No purchases in 2025: the only connection, with Robeson County, is for
    emergencies (contract 0.5 Mgal/day) and carried no water."
    claims:
        E-SC43-LUMBERTON-CITY-INTERCONNECT
            datum: average_through_2025

record lumberton_sold: source "No sales in 2025: the same emergency connection with Robeson County carried no
    water, and the plan gives sales of 0.0000."
    claims:
        E-SC43-LUMBERTON-CITY-INTERCONNECT
            datum: average_through_2025
        E-SC43-LUMBERTON-CITY-USE

record lumberton_homes_population: assumption "SDWIS federal data list 24,460 people served by Lumberton
    (NC0378010), the system's own report through its state."
    assumption A-SC43-REACH
    claims:
        E-SC43-SDWIS-NC0378010
            datum: population_served

record lumberton_va_rate: assumption "24,460 people served times the 2024 GDP per resident of its county
    (Robeson County, North Carolina (37155): 5,044,701 thousand dollars and 118,624 people: 42,526.82 dollars
    a resident) times the price factor 1.026324, over 8,760 h: 121,870.86 USD2025/h."
    assumption A-SC43-ECONOMY
    claims:
        E-SC43-SDWIS-NC0378010
        E-SC43-SDWIS-COUNTIES
        E-SC43-BEA-GDP-37155
        E-SC43-BEA-POP-37155
        E-SC43-GDP-DEFLATOR

record lumberton_hospitals_facilities: assumption "The CMS hospital list gives 1 hospital of the counted types
    whose geocoded address lies in the EPA service area of Lumberton."
    assumption A-SC43-HOSPITAL-JOIN
    claims:
        E-SC43-HOSPITALS-LUMBERTON
            datum: hospitals_supplied
