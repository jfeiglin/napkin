# Blocks 02, 03, 04 and 08 of the spec, with the declarations that they assume.
Pump:
    input rated: L/h = 5

first_pump: Pump
second_pump: Pump

station:
    primary = first_pump
    backup = second_pump
    readonly pumps: <Pump> = <this.primary, this.backup>
    readonly idle_pumps: <Pump> = <>
    water: L = 12 in [0, 20]
    minimum: L = 2
    captured = this.water / (2 h)
    readonly draining = formula(this.water / (2 h))
    readonly ready: formula(bool) = formula(this.water >= this.minimum)
    input delay: h = 3
        in [0.5, 12]
        @timing
    input repair_time = uniform(1 h, 3 h).draw() in [1 h, 12 h]
    initial: L = 12
    tolerance: L = 0.5
    total = formula(this.water)
    assert this.total in [this.initial - this.tolerance, this.initial + this.tolerance]

record timing: assumption "The example assumes a delay of three hours."
