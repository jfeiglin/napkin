scenario "Two bounded tanks"
    horizon 3.25 h
yard:
    a: L = 3.2255859375 L in [0 L,]
    b: L = 1.5244140625 L in [0 L,4 L]
    flow forward: this.b -> this.a
        request = formula(max(0 L/h, (-4.0625 L/h + (2.5 L/h/h) * t)))
        capacity = formula(max(0 L/h, (-4.0625 L/h + (2.5 L/h/h) * t)))
    flow backward: this.a -> this.b
        request = formula(max(0 L/h, -(-4.0625 L/h + (2.5 L/h/h) * t)))
    idle = event():
        after 0.203125 h
yard.idle.start()
