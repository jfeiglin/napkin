scenario "Stock decisions"
    horizon 1 h
yard:
    choose = solver:
        solve_for:
            x: L in [0 L, 1000000000 L]
            y: L in [0 L, ] scale 1 L
        objective:
            maximize(x + y)
chosen_x: formula(L) = formula(yard.choose.x)
chosen_y: formula(L) = formula(yard.choose.y)
rank1: formula(L) = formula(yard.choose.x + yard.choose.y)
