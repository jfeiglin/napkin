scenario "Changing filter threshold"
    horizon 2 h
Site:
    input rank: number = 0
site0: Site
    rank = 1
site1: Site
    rank = 2
yard:
    threshold: number = 0
    result: number = 0
    eligible = formula(count(Site.instances.where(rank >= this.threshold)))
    change = event():
        after 1.0 h:
            this.threshold = 2
    alarm = event():
        when this.eligible == 1:
            this.alarm.start()
        after 0 h:
            this.result += 1
    wait = event():
        until this.eligible == 1
        after 0 h:
            this.result += 10
yard.change.start()
yard.wait.start()
