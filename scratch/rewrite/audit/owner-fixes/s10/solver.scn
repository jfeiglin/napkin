scenario "Solver sets a flow through an input alias"
    horizon 1 h
box:
    input meter: L/h = 3 L/h @measurement
    input spare: L/h = 11 L/h @other
    stock: L = 0 L
    flow feed: SOURCE -> this.stock
        request = 16 L/h
    rate = formula(this.feed.actual_rate)
    plan = solver:
        inputs:
            target = this.feed
            cap = this.meter
            unused = this.spare
        solve_for:
            target.actual_rate
        constraints:
            target.actual_rate <= cap
        objective:
            maximize(target.actual_rate)
record measurement: source "Measured limit."
record other: source "Independent reading."
