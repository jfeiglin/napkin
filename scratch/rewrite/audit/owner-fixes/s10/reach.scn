scenario "Certain dispatch"
    horizon 3 h
Depot:
    input forecast: distribution(enum[WAIT, SEND]) = categorical(WAIT: 1, SEND: 0)
    stock: L = 10 L in [0 L,]
    moved: L = 0 L in [0 L,]
    waits = 0
    choose = event():
        order: enum[WAIT, SEND] = WAIT
        after 1 h:
            order = this.forecast.draw()
            switch order:
                SEND:
                    this.dispatch.start()
                WAIT:
                    this.waits += 1
    dispatch = event():
        after 0 h:
            move 4 L from this.stock to this.moved
yard: Depot
yard.choose.start()
