scenario "Round trip"
    horizon 3 h
Bin:
    stock: L = 2 L
    receipts: L = 0 L
first: Bin
    stock = 10 L
second: Bin
yard:
    floor = formula(min(Bin.instances.stock))
    ceiling = formula(max(Bin.instances.stock))
    total = formula(sum(Bin.instances.stock))
    least_receipts = formula(min(Bin.instances.receipts))
    exchange = event():
        after 1 h:
            move 4 L from first.stock to second.stock
            second.receipts += 4 L
        after 1 h:
            move 4 L from second.stock to first.stock
            first.receipts += 4 L
yard.exchange.start()
