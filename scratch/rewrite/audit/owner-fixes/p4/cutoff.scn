scenario "Fixed cutoff"
    horizon 4 h
yard:
    picked = formula(this.batch.occurrences.at(2 h).amount)
    count_batches = formula(count(this.batch.occurrences))
    batch = event(amount: L):
        after 4 h
    launch = event():
        after 1 h:
            this.batch.start(2 L)
        after 2 h:
            this.batch.start(14 L)
yard.batch.start(10 L)
yard.launch.start()
