scenario "Read the occurrence captured by this run"
    horizon 3 h
yard:
    input delay: h = 0.25 h
    measure = event(amount: L):
        after 4 h
    capture = event():
        job = this.measure.occurrences.at(t)
        observed = formula(job.amount)
        origin = formula(job.started)
        after 4 h
    load = event():
        after 1 h:
            this.measure.start(9 L)
    launch = event():
        after this.delay:
            this.capture.start()
yard.measure.start(2 L)
yard.load.start()
yard.launch.start()
