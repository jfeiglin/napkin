# examples/piano_tuners: two units of its own (units.json), a stock, a flow and a distribution.
scenario "Piano tuners"
    summary "The tuners of a town tune the pianos that need a tuning. How many tunings do they do in a year?"
    horizon 1 year
    scope "The pianos of one town."

tuners:
    "The piano tuners of the town."
    role environment
    input rate = pert(600 tunings/tuner-year, 1000 tunings/tuner-year,
        1200 tunings/tuner-year) in 500 tunings/tuner-year to 1500 tunings/tuner-year
        "Tunings that one tuner does in a year"
        @assumption "The example assumes about four tunings in each working day, and a spread around it."
    input staff = 3 tuner in 1 tuner to 10 tuner
        "Tuners in the town"
        @assumption "The example assumes three tuners."
    input need = 5000 tunings in 0 tunings to 20000 tunings
        "Tunings that the pianos need in the year"
        @assumption "The example assumes 2500 pianos, each tuned twice in a year."
    var due: tunings = need size 20000 tunings  @counts
        "Tunings that the pianos still need"
    var done: tunings = 0 tunings size 20000 tunings  @counts
        "Tunings done"
    flow tune: due -> done at rate * staff  @counts

output tunings_done: tunings = tuners.done
    "Tunings done in the year"
    @identity "The tunings that the tuners do, each counted once."

record counts: identity "The model counts each tuning once: a piano needs it, then a tuner does it."
